{
  "name": "github-engineering-insights",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx apps/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/apps/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "Local-first DORA, SPACE and GitHub Copilot metrics dashboard for GitHub Enterprise Cloud",
  "keywords": [
    "dora",
    "space-framework",
    "github-copilot",
    "engineering-metrics",
    "dashboard"
  ]
}
